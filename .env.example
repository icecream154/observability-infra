# 1. 固定版本；升级时同时检查 UI/API、Collector 和 ClickHouse 的兼容性。
# ClickStack 使用官方 HyperDX 镜像名称，版本来自上游 2.43.1 发布。
CLICKSTACK_APP_IMAGE=hyperdx/hyperdx:2.43.1
CLICKSTACK_COLLECTOR_IMAGE=hyperdx/hyperdx-otel-collector:2.43.1
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.36.3-alpine
MONGODB_IMAGE=mongo:5.0.32-focal

# 2. 本地端口；Compose 仅绑定 127.0.0.1，不占用业务服务的 8080 或 8000。
HYPERDX_APP_PORT=18080
HYPERDX_API_PORT=18001
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# 3. 复制为 .env 后，分别执行 openssl rand -hex 32 生成两个不同的值。
# 不要使用示例值；CLICKHOUSE_PASSWORD 只使用十六进制字符，因其会插入连接 JSON。
# EXPRESS_SESSION_SECRET 是平台会话密钥，不是上传遥测数据的 Ingestion API Key。
CLICKHOUSE_PASSWORD=
EXPRESS_SESSION_SECRET=

# 4. 2.43.1 legacy/OpAMP 管道的统一建表默认时长（720h = 30 天）。
# 分类型策略由 clickhouse/retention.sql 管理：日志/Span 7 天，指标 30 天。
# 修改环境变量不会迁移已有表；不要重新添加在此版本路径下不生效的分信号 TTL 变量。
TABLES_RETENTION=720h

# 5. 容器内存限制，与磁盘容量限制无关；本地 Docker 需为总量及额外开销预留内存。
CLICKHOUSE_MEMORY_LIMIT=4g
CLICKSTACK_APP_MEMORY_LIMIT=2g
MONGODB_MEMORY_LIMIT=1g
COLLECTOR_MEMORY_LIMIT=1g
