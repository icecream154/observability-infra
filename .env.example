# 1. 固定版本；当前 Collector 使用此镜像的 standalone 独立模式，不依赖 HyperDX/OpAMP。
# 保留与已有 legacy/Map 表结构配套的导出器；更换镜像前核对 schema 和自定义配置。
CLICKSTACK_APP_IMAGE=hyperdx/hyperdx:2.43.1
CLICKSTACK_COLLECTOR_IMAGE=hyperdx/hyperdx-otel-collector:2.43.1
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.36.3-alpine
MONGODB_IMAGE=mongo:5.0.32-focal

# 2. HyperDX 前端入口与浏览器访问地址。
# 默认发布所有宿主机网卡，支持其他电脑连接；也可填写具体内网 IP。
# 若使用本机 Nginx/Caddy 代理，将绑定改为 127.0.0.1，并把 PUBLIC_URL 改成真实 HTTPS origin。
HYPERDX_BIND_ADDRESS=0.0.0.0
# Demo 保留本地地址。真实部署改成 http://服务器IP:18080 或 https://你的域名，不带末尾子路径。
# PUBLIC_URL 用于 Cookie、登录跳转、链接和跨域；设置 https 不会自动开启容器 TLS 或申请证书。
HYPERDX_PUBLIC_URL=http://localhost:18080
# 默认避开业务服务常用的 8080/8000；前端宿主机与容器内端口相同。
HYPERDX_APP_PORT=18080
# API 仍仅发布到 127.0.0.1，普通浏览器通过前端 /api 代理访问，不需要将它开放给外部电脑。
HYPERDX_API_PORT=18001

# 3. 多台 Go/Python 机器的统一 OTLP 入口。
# 0.0.0.0 支持宿主机外部连接；可改为中心服务器内网 IP。
# 若仅经本机 HTTPS OTLP 代理接收 HTTP，可改为 127.0.0.1；该操作也会收紧 gRPC 入口。
# 业务发送端使用中心服务器 IP/域名，不能使用 Docker 内部 collector 服务名或远端机器的 localhost。
OTLP_BIND_ADDRESS=0.0.0.0
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# 4. 复制为 .env 后，分别执行 openssl rand -hex 32，生成三个不同的随机值并稳定保存。
# 不要使用示例值；CLICKHOUSE_PASSWORD 只使用十六进制字符，因其会插入连接 JSON。
# EXPRESS_SESSION_SECRET 保护网页登录会话；OTLP_AUTH_TOKEN 是独立 Collector 接收认证。
# 三者用途不同；OTLP_AUTH_TOKEN 在部署前提供，不用先注册 HyperDX 或复制 UI 的团队 Ingestion key。
# OTLP_AUTH_TOKEN 同样使用十六进制，便于拼入标准 OTLP headers；发送端配置 authorization: <此值>。
# 空值会阻止 Compose 启动。真实项目应通过部署 Secret 提供，不提交 .env 或密钥到公共仓库。
CLICKHOUSE_PASSWORD=
EXPRESS_SESSION_SECRET=
OTLP_AUTH_TOKEN=

# 5. 统一新表默认保留时长（720h = 30 天），custom.yaml 显式覆盖 standalone 内置导出器使其生效。
# 接受统一期限的新环境无需执行 retention.sql；需要日志/Span 7 天、指标 30 天时才显式执行它。
# 修改环境变量不迁移已有表 TTL，不再执行 SQL 也不会恢复旧表默认值。
TABLES_RETENTION=720h

# 6. 容器内存限制，与磁盘容量限制无关；需为总量及额外开销预留内存。
# COLLECTOR_MEMORY_LIMIT 改变时，还需同步核对 collector/custom.yaml 的固定堆内存保护阈值。
CLICKHOUSE_MEMORY_LIMIT=4g
CLICKSTACK_APP_MEMORY_LIMIT=2g
MONGODB_MEMORY_LIMIT=1g
COLLECTOR_MEMORY_LIMIT=1g
